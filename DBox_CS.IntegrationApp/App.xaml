<Application x:Class="DBox_CS.IntegrationApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DBox_CS.IntegrationApp"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <FontFamily x:Key="MainFont" >TT Hoves</FontFamily>
        <FontFamily x:Key="MainFont2" >Comfortaa</FontFamily>

        <SolidColorBrush Color="#333333" x:Key="MainColor"></SolidColorBrush>

        <SolidColorBrush Color="#000000" x:Key="ForegroundInputBrush"></SolidColorBrush>
        <SolidColorBrush Color="#FFFFFF" x:Key="HeaderBackgroundBrush"></SolidColorBrush>
        <SolidColorBrush Color="#808080" x:Key="WatermarkForegroundDarkBrush"></SolidColorBrush>
        <SolidColorBrush Color="#000000" x:Key="TextBorderBrush"></SolidColorBrush>

        <!--Background Colors-->
        <Color x:Key="primaryBackColor1">#FFFFFF</Color>
        <Color x:Key="primaryBackColor2">#252E34</Color>

        <!--Window Border Colors-->
        <Color x:Key="winBorderColor1">#252E34</Color>
        <Color x:Key="winBorderColor2">#FFFFFF</Color>
        <Color x:Key="winBorderColor3">#252E34</Color>

        <!--#region TextBlock-->
        <Style x:Key="HeaderTextBlock" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont2}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource MainColor}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5 0 0 0"/>
        </Style>
        <!--#endregion-->
        
        <!--#region Button Styles-->
        <Style x:Key="NormalButton" TargetType="{x:Type Button}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource MyFocusVisual}" />
            <!--<Setter Property="Background" Value="#BCBEC0" />-->
            <Setter Property="Background" Value="{StaticResource MainColor}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" BorderThickness="0" Padding="0" BorderBrush="White" CornerRadius="16" Background="{TemplateBinding Background}" >
                            <Grid >
                                <ContentPresenter HorizontalAlignment="Center"   VerticalAlignment="Center"  x:Name="contentShadow" Style="{StaticResource ShadowStyle}"/>
                                <ContentPresenter HorizontalAlignment="Stretch"    VerticalAlignment="Center" x:Name="content"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefaulted" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#e66a1f" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#e66a1f" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#00305d" />
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MyFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <Grid Margin="4 2">
                            <Rectangle Name="r1" StrokeThickness="1" Stroke="Black" StrokeDashArray="2 2"/>
                            <Border Name="border" Width="{TemplateBinding ActualWidth}" Height="{TemplateBinding ActualHeight}"  CornerRadius="2" BorderThickness="0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShadowStyle">
            <Setter Property="Control.Foreground" Value="LightGray" />
        </Style>

        <Style x:Key="ButtonTextBlockFooter" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 0 0 0"/>
        </Style>
        <Style x:Key="ButtonTextBlockFooter2" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 0 0 0"/>
        </Style>

        <DropShadowEffect x:Key="thresholdEffect" Color="Gray" Opacity=".50" ShadowDepth="5" />

        <Style x:Key="NormalButtonConfirm" TargetType="{x:Type Button}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Foreground" Value="WhiteSmoke" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource MyFocusVisual}" />
            <Setter Property="Background" Value="{StaticResource MainColor}"/>
            <Setter Property="Effect" Value="{StaticResource thresholdEffect}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" BorderThickness="0" Padding="0" BorderBrush="White" CornerRadius="12" Background="{TemplateBinding Background}" >
                            <Grid >
                                <ContentPresenter HorizontalAlignment="Center"   VerticalAlignment="Center"  x:Name="contentShadow" Style="{StaticResource ShadowStyle}"/>
                                <ContentPresenter HorizontalAlignment="Center"   VerticalAlignment="Center" x:Name="content"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefaulted" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#e66a1f" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#e66a1f" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#00305d" />
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!--<Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightGray"/>
                </Trigger>-->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="LightGray"/>
                </MultiTrigger>
                <!-- Optional: Handle Disabled State Background -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Gray"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="Content" Value="X"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Comfortaa"/>
            <Setter Property="Foreground" Value="#252E34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Width="18" Height="18"
                                    CornerRadius="9"
                                    Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Red"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MinimizeStyle" TargetType="Button">
            <Setter Property="Background" Value="#278BEF"/>
            <Setter Property="Content" Value="-"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Comfortaa"/>
            <Setter Property="Foreground" Value="#252E34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Width="18" Height="18"
                                    CornerRadius="9"
                                    Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!--#endregion-->

        <!--#region ProgressBarStyles-->
        <!-- Rounded ProgressBar Style -->
        <Style x:Key="RoundedProgressBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <!-- Background -->
                            <Border Background="#e0e0e0" CornerRadius="10" Height="20" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <Border x:Name="PART_Track" Background="#e0e0e0" CornerRadius="10" />
                            </Border>
                            <!-- Foreground (Moving part of the ProgressBar) -->
                            <Border x:Name="PART_Indicator" Background="#007ACC" CornerRadius="10" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <!--#endregion-->

    </Application.Resources>
</Application>
