<Window x:Class="DBox_CS.IntegrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DBox_CS.IntegrationApp"
        mc:Ignorable="d"  WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True"
        Title=""  MinHeight="220" MinWidth="300"  Height="220" Width="300" MouseDown="Window_MouseDown">

    <Border CornerRadius="22" BorderThickness="2" Opacity="100" Margin="0,0,0,-85">
        <!--#region Background & Border-->
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0 0" EndPoint="1 1">
                <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                <!--<GradientStop Color="{StaticResource winBorderColor2}" Offset="0.75"/>-->
                <GradientStop Color="{StaticResource winBorderColor1}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush>
                <GradientStop Color="{StaticResource primaryBackColor1}"/>
            </LinearGradientBrush>
        </Border.Background>
        <!--#endregion-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="Unifocus Integration" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"  Style="{StaticResource HeaderTextBlock}"/>
                <Button x:Name="btnMinimize" Style="{StaticResource MinimizeStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="70 0 0 0" Click="btnMinimize_Click" FocusVisualStyle="{x:Null}"/>
                <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5" Click="btnClose_Click" FocusVisualStyle="{x:Null}"/>
            </StackPanel>

            <!-- Download Button -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,22,22,10" Width="242" Height="199" Grid.Row="1">
                <!-- Process Button -->

                <Button x:Name="UploadEmpToUFButton" Grid.Row="1" Margin="10"  Style="{StaticResource NormalButtonConfirm}"
                HorizontalAlignment="Center" Width="222" Click="UploadEmpToUFButton_Click" FocusVisualStyle="{x:Null}">
                    <!--Click="DownloadButton_Click">-->
                    <TextBlock Text="Employee Upload to UF" Style="{StaticResource ButtonTextBlockFooter}" HorizontalAlignment="Center"/>
                </Button>
                <Button x:Name="UploadLeaveToUFButton" Margin="10"  Style="{StaticResource NormalButtonConfirm}"
                    HorizontalAlignment="Center" Width="222" Click="UploadLeaveToUFButton_Click" FocusVisualStyle="{x:Null}">
                    <!--Click="DownloadButton_Click">-->
                    <TextBlock Text="Leave Upload to UF" Style="{StaticResource ButtonTextBlockFooter}" HorizontalAlignment="Center"/>
                </Button>



                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 0" Width="230">

                    <Button x:Name="DownloadButton"  Style="{StaticResource NormalButtonConfirm}"
                HorizontalAlignment="Center" Width="109" Click="DownloadButton_Click" FocusVisualStyle="{x:Null}">
                        <!--Click="DownloadButton_Click">-->
                        <TextBlock Text="Download Daily Hours File" Style="{StaticResource ButtonTextBlockFooter2}" HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ProcessButton"  Style="{StaticResource NormalButtonConfirm}"
                HorizontalAlignment="Center" Width="109" Click="ProcessButton_Click"  FocusVisualStyle="{x:Null}">
                        <!--Click="DownloadButton_Click">-->
                        <TextBlock Text="Process Daily Hours" Style="{StaticResource ButtonTextBlockFooter2}" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>



            </StackPanel >

            <!-- Progress Bar -->
            <ProgressBar x:Name="DownloadProgressBar" Grid.Row="2"
                     IsIndeterminate="True" Visibility="Collapsed"   Minimum="0" Maximum="100" Value="50" />
            <!--<ProgressBar x:Name="DownloadProgressBar" Grid.Row="2" Style="{DynamicResource RoundedProgressBar}"  Minimum="0" Maximum="100" Value="0" />-->

        </Grid>
    </Border>
</Window>
